# ============================================================
# Digimuda ShowRoom — Template Environment Variables
# Copy file ini ke .env.local untuk development lokal.
# Nilai STAGING & PRODUCTION di-set lewat Vercel Dashboard
# (scope Preview / Production), BUKAN lewat file env di repo.
# ============================================================

# URL proyek Supabase.
# Lokal (supabase start): http://localhost:54321
# Prefix NEXT_PUBLIC_ = ikut ter-bundle ke browser, jadi HANYA
# untuk nilai yang aman dilihat publik.
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key proyek Supabase.
# Aman publik HANYA karena RLS membatasi akses data di server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPSIONAL — hanya untuk kebutuhan admin server-side (belum dipakai di langkah 1-7).
# JANGAN pernah pakai prefix NEXT_PUBLIC_ dan JANGAN dipakai di kode client.
# SUPABASE_SERVICE_ROLE_KEY=

# Varian hero yang tampil default. Override via ?hero=video|image|split
# Nilai valid: split | image | video
NEXT_PUBLIC_HERO_VARIANT=split
